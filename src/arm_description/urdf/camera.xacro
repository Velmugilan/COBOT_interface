<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- RGB-D camera mounted on the wrist flange (eye-in-hand). -->
  <xacro:macro name="wrist_camera" params="prefix parent
                                           xyz:='0.05 0 0.03'
                                           rpy:='0 0 0'">

    <link name="${prefix}camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
        <material name="camera_dark"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.090 0.025"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.072"/>
        <inertia ixx="0.0000536" ixy="0" ixz="0"
                 iyy="0.0000135" iyz="0" izz="0.0000536"/>
      </inertial>
    </link>

    <joint name="${prefix}camera_mount_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child  link="${prefix}camera_link"/>
    </joint>

    <!-- Optical frame: REP-103 says z forward, x right, y down -->
    <link name="${prefix}camera_optical_frame"/>
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="${prefix}camera_link"/>
      <child  link="${prefix}camera_optical_frame"/>
    </joint>

    <gazebo reference="${prefix}camera_link">
      <sensor name="wrist_rgbd" type="rgbd_camera">
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>wrist_camera</topic>
        <gz_frame_id>${prefix}camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
