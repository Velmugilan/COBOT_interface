<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parallel-jaw gripper. One actuated finger, one mimic.
       Stroke 0 to 0.04 m per finger = 0.08 m total opening. -->
  <xacro:macro name="parallel_gripper" params="prefix parent">

    <!-- Base plate bolted to the flange -->
    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><box size="0.06 0.12 0.04"/></geometry>
        <material name="gripper_grey"><color rgba="0.3 0.3 0.32 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><box size="0.06 0.12 0.04"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.00067" ixy="0" ixz="0"
                 iyy="0.00022" iyz="0" izz="0.00075"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child  link="${prefix}gripper_base"/>
    </joint>

    <xacro:macro name="finger" params="side reflect">
      <link name="${prefix}finger_${side}">
        <visual>
          <origin xyz="0 0 0.035" rpy="0 0 0"/>
          <geometry><box size="0.02 0.02 0.07"/></geometry>
          <material name="finger_dark"><color rgba="0.15 0.15 0.15 1"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0.035" rpy="0 0 0"/>
          <geometry><box size="0.02 0.02 0.07"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0.035" rpy="0 0 0"/>
          <mass value="0.05"/>
          <inertia ixx="0.0000221" ixy="0" ixz="0"
                   iyy="0.0000221" iyz="0" izz="0.0000033"/>
        </inertial>
      </link>
      <gazebo reference="${prefix}finger_${side}">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.002</minDepth>
      </gazebo>
    </xacro:macro>

    <xacro:finger side="left"  reflect="1"/>
    <xacro:finger side="right" reflect="-1"/>

    <!-- Actuated finger: slides along +Y -->
    <joint name="${prefix}finger_joint" type="prismatic">
      <origin xyz="0 0.01 0.04" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}finger_left"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="60.0" velocity="0.15"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- Mirror finger: mimics the first, opposite direction -->
    <joint name="${prefix}finger_joint_mimic" type="prismatic">
      <origin xyz="0 -0.01 0.04" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}finger_right"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="60.0" velocity="0.15"/>
      <mimic joint="${prefix}finger_joint" multiplier="1.0" offset="0.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- Grasp reference frame: midpoint between the fingertips -->
    <link name="${prefix}grasp_frame"/>
    <joint name="${prefix}grasp_frame_joint" type="fixed">
      <origin xyz="0 0 0.105" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}grasp_frame"/>
    </joint>

  </xacro:macro>

</robot>
